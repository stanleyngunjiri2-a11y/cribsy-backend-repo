# Copy this file to .env and configure your actual credentials.
# Never commit .env or expose its secrets.

SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-another-long-random-secret

# PostgreSQL database URL (required)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

# Frontend configuration
CORS_ORIGINS=https://cribsy-system.vercel.app
FRONTEND_URL=https://cribsy-system.vercel.app

# Development only. MUST be false in production.
SHOW_DEV_CODES=false

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SendGrid email delivery
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=samanthangiela@gmail.com
