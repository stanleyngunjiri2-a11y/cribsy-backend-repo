# Copy this file to .env and configure your actual credentials.
# Never commit .env or expose its secrets.

SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-another-long-random-secret

# Local development database
DATABASE_URL=sqlite:///cribsy.db

# For PostgreSQL deployments, use:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

# Frontend configuration
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Development only. MUST be false in production.
SHOW_DEV_CODES=true

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


